<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#080d1c">
<title>Cyber AI</title>
<style>
:root{--bg:#080d1c;--panel:#111c30;--panel2:#182842;--line:#293d5a;--text:#edf4ff;--muted:#91a5c2;--blue:#438cf5;--cyan:#43d9d0;--red:#f16b80;--green:#5cdaa1}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Arial,Helvetica,sans-serif;background:var(--bg);color:var(--text)}
body{background:radial-gradient(ellipse at top,#1b3151,#080d1c 65%);min-height:100vh}
button,input,textarea,select{font:inherit}
button{cursor:pointer;color:inherit}
button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.app{max-width:1500px;margin:auto;padding:14px;display:grid;grid-template-columns:245px minmax(0,1fr);gap:15px;min-height:100vh}
.sidebar,.card{background:linear-gradient(145deg,#142139,#0d1729);border:1px solid var(--line);border-radius:19px}
.sidebar{padding:16px;display:flex;flex-direction:column;gap:17px;height:calc(100vh - 28px);position:sticky;top:14px}
.brand{display:flex;align-items:center;gap:11px;padding-bottom:15px;border-bottom:1px solid var(--line)}
.logo{width:43px;height:43px;border-radius:13px;background:linear-gradient(135deg,#3987f5,#45ded0);display:grid;place-items:center;color:#061426;font-size:24px;font-weight:900}
.brand h1{font-size:18px;margin:0}
.brand small{font-size:11px;color:var(--muted)}
.nav{display:grid;gap:7px}
.nav button,.side-action{background:transparent;border:1px solid transparent;border-radius:11px;padding:12px;text-align:left;color:#bdcbe0;display:flex;align-items:center;gap:11px}
.nav button.active,.nav button:hover,.side-action:hover{background:#203654;border-color:#355477;color:white}
.nav svg{width:20px;height:20px;stroke:var(--cyan);fill:none;stroke-width:1.8}
.sidebar-bottom{margin-top:auto}
.status{background:#091426;border:1px solid var(--line);border-radius:12px;padding:12px;font-size:12px;color:var(--muted);line-height:1.7}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--red);margin-right:6px}
.dot.online{background:var(--green)}
main{min-width:0;display:flex;flex-direction:column;gap:15px}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:10px}
.topbar h2{font-size:25px;margin:0}
.topbar p{font-size:12px;color:var(--muted);margin:5px 0 0}
.top-actions{display:flex;gap:7px;flex-wrap:wrap}
.btn{background:#1b2d48;border:1px solid var(--line);padding:10px 14px;border-radius:11px;font-weight:600}
.btn.primary{background:linear-gradient(120deg,#3987f5,#36c7c0);border:0;color:#061426}
.btn.danger{background:#472235;border-color:#75384f}
.btn.small{padding:7px 10px;font-size:12px}
.btn:disabled{opacity:.45}
.page{display:none}
.page.active{display:block}
.card{padding:17px;min-width:0}
.card h3{margin:0 0 12px;font-size:16px}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:13px}
.span-12{grid-column:span 12}
.span-8{grid-column:span 8}
.span-6{grid-column:span 6}
.span-4{grid-column:span 4}
.muted,.help{color:var(--muted)}
.help{font-size:12px;line-height:1.6}
.hero{display:grid;grid-template-columns:1fr 1fr;gap:15px;align-items:center}
.hero h3{font-size:clamp(27px,4vw,43px);line-height:1.1;margin:0 0 12px}
.hero p{color:#afc0d8;line-height:1.7}
.hero-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:17px}
.avatar{height:290px;border:1px solid #355172;border-radius:17px;background:radial-gradient(ellipse at center,#294b70,#101c30 70%);position:relative;overflow:hidden}
.avatar canvas{width:100%;height:100%;display:block}
.avatar-words{position:absolute;top:12px;left:12px;right:12px;padding:10px;background:#071321dc;border:1px solid #5278a1;border-radius:10px;font-size:12px;white-space:pre-wrap}
.avatar-label{position:absolute;bottom:12px;left:12px;padding:7px 10px;background:#071321dc;border-radius:9px;font-size:11px}
.stat{display:flex;justify-content:space-between;align-items:center}
.stat strong{font-size:25px}
.stat-symbol{color:var(--cyan);font-size:22px}
.field{display:grid;gap:6px;margin:12px 0}
.field label{font-size:12px;color:var(--muted)}
.field input,.field textarea,.field select{width:100%;background:#091426;border:1px solid #304562;color:white;border-radius:10px;padding:11px}
.field textarea{min-height:90px;resize:vertical}
.tool-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px}
.tool-tile{background:#101e33;border:1px solid var(--line);border-radius:13px;padding:14px;text-align:left}
.tool-tile:hover{border-color:var(--cyan);background:#172b47}
.tool-tile svg{width:29px;height:29px;stroke:var(--cyan);fill:none;stroke-width:1.8;margin-bottom:9px}
.tool-tile b{display:block;font-size:13px;margin-bottom:5px}
.tool-tile span{font-size:11px;color:var(--muted)}
.list{display:grid;gap:8px}
.item{display:flex;align-items:center;gap:10px;background:#101e33;border:1px solid var(--line);padding:11px;border-radius:11px}
.item .grow{flex:1;min-width:0}
.item.done{text-decoration:line-through;opacity:.6}
.empty{text-align:center;padding:25px;color:var(--muted);font-size:13px}
.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);padding:12px 17px;background:#203653;border:1px solid #49688c;border-radius:12px;display:none;z-index:50;max-width:90vw}
@media(max-width:850px){
.app{grid-template-columns:1fr;padding:9px}
.sidebar{height:auto;position:relative;top:auto;padding:11px}
.sidebar-bottom{display:none}
.nav{grid-template-columns:repeat(4,minmax(0,1fr))}
.nav button{flex-direction:column;justify-content:center;gap:5px;padding:9px 3px;font-size:10px}
.hero{grid-template-columns:1fr}
.avatar{height:250px}
.span-8,.span-6,.span-4{grid-column:span 12}
}
@media(max-width:480px){
.topbar h2{font-size:20px}
.top-actions .btn{padding:8px;font-size:11px}
.card{padding:13px}
.tool-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
}
</style>
</head>
<body>
<div class="app">
<aside class="sidebar">
<div class="brand">
<div class="logo">C</div>
<div><h1>CYBER AI</h1><small>PERSONAL AI ASSISTANT</small></div>
</div>
<nav class="nav" id="mainNavigation">
<button class="active" data-page="home">
<svg viewBox="0 0 24 24"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/></svg>Home
</button>
<button data-page="chat">
<svg viewBox="0 0 24 24"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9 9 0 0 1-4-.9L3 21l1.9-4.5A8.5 8.5 0 1 1 21 11.5Z"/></svg>Chat
</button>
<button data-page="tools">
<svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>Tools
</button>
<button data-page="history">
<svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5m4-1v5l4 2"/></svg>History
</button>
<button data-page="phone">
<svg viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M10 18h4"/></svg>Phone
</button>
<button data-page="settings">
<svg viewBox="0 0 24 24"><path d="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z"/><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.6a8 8 0 0 1-1.5.9L16 20.7h-8l-.3-1.8a8 8 0 0 1-1.5-.9l-1.7.6-1.4-2.4 1.4-1.1a8 8 0 0 1 0-1.8l-1.4-1.1 1.4-2.4 1.7.6a8 8 0 0 1 1.5-.9L8 3.7h8l.3 1.8a8 8 0 0 1 1.5.9l1.7-.6 1.4 2.4-1.4 1.1a8 8 0 0 1-.1 1.8Z"/></svg>Settings
</button>
</nav>
<div class="sidebar-bottom">
<div class="status"><span class="dot" id="connectionDot"></span><span id="connectionStatus">Checking connection...</span><br><span id="deviceClock">Device time</span></div>
</div>
</aside>
<main>
<header class="topbar">
<div><h2 id="pageTitle">Welcome to Cyber AI</h2><p id="pageSubtitle">Your intelligent personal assistant</p></div>
<div class="top-actions">
<button class="btn" id="themeButton">Appearance</button>
<button class="btn primary" id="topChatButton">Open chat</button>
</div>
</header>
<!-- PART 1 ENDS HERE: PART 2 CONTINUES INSIDE main -->
<section class="page active" id="page-home">
<div class="grid">
<div class="card span-12 hero">
<div class="hero-copy">
<h3>Your personal AI.<br>Your digital assistant.</h3>
<p>Welcome to Cyber AI. Chat, use smart tools, manage supported phone features and get help with everyday tasks.</p>
<div class="hero-actions">
<button class="btn primary" onclick="goToPage('chat')">Start chatting</button>
<button class="btn" onclick="goToPage('tools')">Explore tools</button>
</div>
</div>
<div class="avatar" id="avatarArea">
<canvas id="avatarCanvas"></canvas>
<div class="avatar-words" id="avatarWords">CYBER AI READY</div>
<div class="avatar-label">CYBER AI ASSISTANT</div>
</div>
</div>
<div class="card span-4">
<div class="stat"><div><div class="muted">Assistant status</div><strong id="assistantStatus">Ready</strong></div><div class="stat-symbol">◉</div></div>
<p class="help">Your assistant is ready to receive a message.</p>
</div>
<div class="card span-4">
<div class="stat"><div><div class="muted">Device time</div><strong id="homeClock">--:--</strong></div><div class="stat-symbol">◷</div></div>
<p class="help" id="homeDate">Waiting for device clock.</p>
</div>
<div class="card span-4">
<div class="stat"><div><div class="muted">Connection</div><strong id="homeConnection">Checking</strong></div><div class="stat-symbol">⌁</div></div>
<p class="help">Some assistant features require internet access.</p>
</div>
<div class="card span-12">
<h3>Quick tools</h3>
<div class="tool-grid">
<button class="tool-tile" onclick="goToPage('chat')">
<svg viewBox="0 0 24 24"><path d="M21 11.5a8.5 8.5 0 0 1-9 8.5 9 9 0 0 1-4-.9L3 21l1.9-4.5A8.5 8.5 0 1 1 21 11.5Z"/></svg>
<b>AI Chat</b><span>Ask questions and get answers</span>
</button>
<button class="tool-tile" onclick="goToPage('tools')">
<svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
<b>All tools</b><span>Explore assistant tools</span>
</button>
<button class="tool-tile" onclick="goToPage('phone')">
<svg viewBox="0 0 24 24"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M10 18h4"/></svg>
<b>Phone controls</b><span>Open supported phone controls</span>
</button>
<button class="tool-tile" onclick="goToPage('history')">
<svg viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5m4-1v5l4 2"/></svg>
<b>Chat history</b><span>Review saved conversations</span>
</button>
</div>
</div>
</div>
</section>

<section class="page" id="page-chat">
<div class="grid">
<div class="card span-8">
<div class="chat-head">
<div><h3>Cyber AI Chat</h3><div class="help" id="chatStatus">Ready to chat</div></div>
<button class="btn small" id="clearChat">Clear chat</button>
</div>
<div class="messages" id="messages" aria-live="polite">
<div class="msg assistant">Hello! I am Cyber AI. How can I help you today?</div>
</div>
<div class="composer">
<div class="compose-row">
<textarea id="chatInput" rows="1" placeholder="Message Cyber AI..." aria-label="Your message"></textarea>
<button class="icon-btn" id="micButton" title="Start or stop voice typing" aria-label="Voice typing">⌁</button>
<button class="btn primary" id="sendButton">Send</button>
</div>
<div class="compose-tools">
<button class="btn small" id="voiceReplyButton">Voice replies: ON</button>
<button class="btn small" id="liveModeButton">Live mode</button>
<button class="btn small" id="attachButton">Attach</button>
<input type="file" id="attachmentInput" hidden>
</div>
<div class="help" id="micStatus">Tap the microphone to start voice typing.</div>
</div>
</div>
<div class="card span-4 chat-side">
<h3>Assistant tools</h3>
<div class="quick-list">
<button onclick="goToPage('tools')">Explore all tools</button>
<button onclick="goToPage('history')">Conversation history</button>
<button onclick="goToPage('phone')">Phone controls</button>
<button onclick="goToPage('settings')">Assistant settings</button>
</div>
<div class="footer-note">Voice typing and spoken replies depend on browser support or the Android native bridge.</div>
</div>
</div>
</section>

<section class="page" id="page-tools">
<div class="card">
<h3>Cyber AI tools</h3>
<p class="help">Choose a tool to open its workspace.</p>
<div class="tool-grid">
<button class="tool-tile" onclick="openTool('qr')">
<svg viewBox="0 0 24 24"><path d="M3 3h7v7H3zM14 3h7v7h-7zM3 14h7v7H3zM14 14h3v3h-3zM19 14v2m-2 3h2m2 0v2"/></svg>
<b>QR Generator</b><span>Create QR codes from text or links</span>
</button>
<button class="tool-tile" onclick="openTool('weather')">
<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
<b>Weather</b><span>Check weather information</span>
</button>
<button class="tool-tile" onclick="openTool('translate')">
<svg viewBox="0 0 24 24"><path d="M4 5h12M10 3v2m4 0c0 6-4 10-9 12m2-8c1 3 4 6 7 7m2-2 4 7m-6-3h7"/></svg>
<b>Translator</b><span>Translate between languages</span>
</button>
<button class="tool-tile" onclick="openTool('summarize')">
<svg viewBox="0 0 24 24"><path d="M5 3h10l4 4v14H5zM15 3v5h4M8 12h8m-8 4h8m-8 4h5"/></svg>
<b>Text summarizer</b><span>Summarize long text</span>
</button>
<button class="tool-tile" onclick="openTool('reminders')">
<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M8 2v4m8-4v4M3 9h18m-13 5h3m-3 3h7"/></svg>
<b>Reminders</b><span>Create and manage reminders</span>
</button>
<button class="tool-tile" onclick="openTool('notes')">
<svg viewBox="0 0 24 24"><path d="M5 3h14v18H5zM8 8h8m-8 4h8m-8 4h5"/></svg>
<b>Notes</b><span>Write and save notes</span>
</button>
<button class="tool-tile" onclick="openTool('calculator')">
<svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8v4H8zm0 8h2m4 0h2m-8 4h2m4 0h2"/></svg>
<b>Calculator</b><span>Perform calculations</span>
</button>
<button class="tool-tile" onclick="openTool('camera')">
<svg viewBox="0 0 24 24"><path d="M3 7h4l2-3h6l2 3h4v13H3z"/><circle cx="12" cy="13" r="4"/></svg>
<b>Camera</b><span>Open camera workspace</span>
</button>
<button class="tool-tile" onclick="openTool('images')">
<svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8" cy="8" r="2"/><path d="m21 15-5-5L5 21"/></svg>
<b>Image studio</b><span>Create image prompts and artwork</span>
</button>
<button class="tool-tile" onclick="openTool('files')">
<svg viewBox="0 0 24 24"><path d="M3 6a2 2 0 0 1 2-2h5l2 3h7a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
<b>File workspace</b><span>Choose and read supported files</span>
</button>
</div>
</div>
<div class="card" id="toolWorkspace" hidden>
<div class="stat"><h3 id="toolTitle">Tool workspace</h3><button class="btn small" onclick="closeTool()">Close</button></div>
<div id="toolContent"></div>
</div>
</section>

<section class="page" id="page-history">
<div class="card">
<h3>Conversation history</h3>
<p class="help">Your saved conversations will appear here.</p>
<div class="list" id="historyList">
<div class="empty">No saved conversations yet.</div>
</div>
</div>
</section>
