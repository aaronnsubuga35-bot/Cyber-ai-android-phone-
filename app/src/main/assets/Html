<div id="toast" class="toast" role="status"></div><script>
"use strict";

const AI_URL = "https://aron-ai-brain.aaronsubuga35.workers.dev/";
const IMAGE_URL = "https://aron-ai-image.aaronsubuga35.workers.dev/";

const $ = id => document.getElementById(id);
let chatHistory = [];
let recognition = null;
let listening = false;
let usageSeconds = 0;
let usageTotal = Number(localStorage.getItem("cyberUsageTotal") || 0);
let usageStarted = false;
let usageInterval = null;
let toastTimer = null;

function toast(message) {
  const el = $("toast");
  if (!el) return;
  el.textContent = message;
  el.classList.add("show");
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove("show"), 2500);
}

function goToPage(name) {
  document.querySelectorAll(".page").forEach(p => p.classList.remove("active"));
  const page = $("page-" + name);
  if (page) page.classList.add("active");

  document.querySelectorAll(".nav-item").forEach(b => {
    b.classList.toggle("active", (b.dataset.page || "").toLowerCase() === name);
  });

  const titles = {
    home: ["Cyber AI", "Your smart assistant"],
    chat: ["Chat", "Ask Cyber AI anything"],
    tools: ["Tools", "Your creative workspace"],
    history: ["History", "Your conversations"],
    phone: ["Phone controls", "Quick phone shortcuts"],
    settings: ["Settings", "Personalise Cyber AI"]
  };

  const title = titles[name] || ["Cyber AI", ""];
  if ($("pageTitle")) $("pageTitle").textContent = title[0];
  if ($("pageSubtitle")) $("pageSubtitle").textContent = title[1];
}

function openChat() {
  goToPage("chat");
  const input = $("chatInput");
  if (input) input.focus();
}

function openTool(name) {
  goToPage("tools");
  const workspace = $("toolWorkspace");
  if (!workspace) return;

  const tools = {
    qr: `<h3>QR Generator</h3>
      <input id="qrText" placeholder="Enter text or a website address">
      <button class="primary" onclick="makeQR()">GENERATE QR</button>
      <div id="qrResult"></div>`,
    weather: `<h3>Weather</h3>
      <button class="primary" onclick="getWeather()">CHECK MY WEATHER</button>
      <div id="weatherResult" class="help"></div>`,
    translate: `<h3>Translator</h3>
      <textarea id="translateText" placeholder="Enter text to translate"></textarea>
      <input id="translateLanguage" placeholder="Translate into (e.g. French)">
      <button class="primary" onclick="translateText()">TRANSLATE</button>
      <div id="translateResult"></div>`,
    summarize: `<h3>Text Summarizer</h3>
      <textarea id="summaryText" placeholder="Paste text to summarise"></textarea>
      <button class="primary" onclick="summarizeText()">SUMMARISE</button>
      <div id="summaryResult"></div>`,
    reminders: `<h3>Reminders</h3>
      <input id="reminderText" placeholder="What should I remind you about?">
      <input id="reminderTime" type="datetime-local">
      <button class="primary" onclick="saveReminder()">SAVE REMINDER</button>
      <div id="reminderList"></div>`,
    notes: `<h3>Notes</h3>
      <textarea id="noteText" placeholder="Write your note"></textarea>
      <button class="primary" onclick="saveNote()">SAVE NOTE</button>
      <div id="noteList"></div>`,
    calculator: `<h3>Calculator</h3>
      <input id="calcInput" placeholder="Example: (25+5)*2">
      <button class="primary" onclick="calculate()">CALCULATE</button>
      <div id="calcResult"></div>`,
    camera: `<h3>Camera</h3>
      <video id="cameraVideo" autoplay playsinline style="width:100%;border-radius:12px"></video>
      <button class="primary" onclick="startCamera()">OPEN CAMERA</button>
      <button onclick="stopCamera()">CLOSE CAMERA</button>
      <button onclick="takePhoto()">TAKE PHOTO</button>
      <canvas id="photoCanvas" hidden></canvas>
      <div id="photoResult"></div>`,
    image: `<h3>AI Image Studio</h3>
      <textarea id="imagePrompt" placeholder="Describe the image you want to create"></textarea>
      <button class="primary" onclick="generateImage()">GENERATE IMAGE</button>
      <div id="imageResult"></div>`,
    files: `<h3>Files</h3>
      <input type="file" id="filePicker" multiple>
      <div id="fileResult" class="help">Choose files from your device.</div>`
  };

  workspace.innerHTML = (tools[name] || `<h3>Tool unavailable</h3><p class="help">This tool is not available.</p>`)
    + `<button onclick="closeTool()">CLOSE TOOL</button>`;

  if (name === "reminders") showReminders();
  if (name === "notes") showNotes();

  if (name === "files" && $("filePicker")) {
    $("filePicker").addEventListener("change", e => {
      $("fileResult").textContent = [...e.target.files].map(f => f.name).join(", ") || "No files selected.";
    });
  }
}

function closeTool() {
  if ($("toolWorkspace")) $("toolWorkspace").innerHTML = "";
}

async function askAI(message) {
  const response = await fetch(AI_URL, {
    method: "POST",
    headers: {"Content-Type": "application/json"},
    body: JSON.stringify({message, history: chatHistory})
  });

  if (!response.ok) throw new Error("AI service returned an error.");
  const data = await response.json();
  if (!data.answer) throw new Error("The AI did not return an answer.");
  return data.answer;
}

function addMessage(text, who) {
  const area = $("chatMessages") || $("messages") || document.querySelector(".chat-messages");
  if (!area) return;

  const bubble = document.createElement("div");
  bubble.className = "message " + who;
  bubble.textContent = text;
  area.appendChild(bubble);
  area.scrollTop = area.scrollHeight;
}

async function sendMessage() {
  const input = $("chatInput") || $("messageInput");
  if (!input) return;

  const message = input.value.trim();
  if (!message) return;

  input.value = "";
  addMessage(message, "user");
  chatHistory.push({role: "user", content: message});

  const send = $("sendButton");
  if (send) send.disabled = true;

  try {
    const answer = await askAI(message);
    addMessage(answer, "assistant");
    chatHistory.push({role: "assistant", content: answer});
    showAvatarWords(answer);
    if (!$("voiceReplies") || $("voiceReplies").checked) speak(answer);
    saveHistory(message, answer);
  } catch (error) {
    addMessage("I couldn't connect right now. Check your internet and try again.", "assistant");
    toast(error.message);
  } finally {
    if (send) send.disabled = false;
  }
}

function speak(text) {
  if (!("speechSynthesis" in window)) {
    toast("Speech is not supported in this browser.");
    return;
  }

  speechSynthesis.cancel();
  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = $("voiceLanguage")?.value || "en-US";
  utterance.rate = Number($("voiceRate")?.value || 1);
  utterance.pitch = Number($("voicePitch")?.value || 1);
  speechSynthesis.speak(utterance);
}

function testVoice() {
  speak("Hello. Cyber AI is ready.");
}

function startListening() {
  const SpeechRecognition = window.SpeechRecognition || window.webkitSpeechRecognition;

  if (!SpeechRecognition) {
    toast("Voice typing is not available in this browser. Try Chrome.");
    return;
  }

  if (listening) {
    recognition?.stop();
    return;
  }

  recognition = new SpeechRecognition();
  recognition.lang = $("voiceLanguage")?.value || "en-US";
  recognition.continuous = true;
  recognition.interimResults = true;

  recognition.onstart = () => {
    listening = true;
    toast("Microphone is on. Tap the microphone again to stop.");
  };

  recognition.onresult = event => {
    let words = "";
    for (let i = event.resultIndex; i < event.results.length; i++) {
      words += event.results[i][0].transcript;
    }
    const input = $("chatInput") || $("messageInput");
    if (input) input.value = words;
  };

  recognition.onerror = event => toast("Voice typing error: " + event.error);

  recognition.onend = () => {
    listening = false;
    const mic = $("micButton");
    if (mic) mic.classList.remove("listening");
  };

  recognition.start();
  const mic = $("micButton");
  if (mic) mic.classList.add("listening");
}

function toggleMic() {
  if (listening) recognition?.stop();
  else startListening();
}

function showAvatarWords(text) {
  const words = $("avatarWords");
  if (words) words.textContent = text;
  animateAvatar();
}

function animateAvatar() {
  const canvas = $("avatarCanvas");
  if (!canvas) return;
  const ctx = canvas.getContext("2d");
  if (!ctx) return;

  const width = canvas.width = canvas.clientWidth || 280;
  const height = canvas.height = canvas.clientHeight || 220;
  let frame = 0;

  function draw() {
    ctx.clearRect(0, 0, width, height);
    const x = width / 2;
    const y = height / 2;
    const bob = Math.sin(frame / 8) * 3;

    ctx.fillStyle = "#102b48";
    ctx.beginPath();
    ctx.ellipse(x, y + 5 + bob, 65, 82, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = "#d69a72";
    ctx.beginPath();
    ctx.ellipse(x, y + bob, 47, 61, 0, 0, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = "#20202a";
    ctx.beginPath();
    ctx.ellipse(x, y - 43 + bob, 48, 25, 0, Math.PI, Math.PI * 2);
    ctx.fill();

    ctx.fillStyle = "#20202a";
    ctx.beginPath();
    ctx.arc(x - 17, y - 5 + bob, 4, 0, Math.PI * 2);
    ctx.arc(x + 17, y - 5 + bob, 4, 0, Math.PI * 2);
    ctx.fill();

    ctx.strokeStyle = "#713d38";
    ctx.lineWidth = 3;
    ctx.beginPath();
    ctx.arc(x, y + 19 + bob, 12, 0.15, Math.PI - 0.15);
    ctx.stroke();

    frame++;
    if (frame < 80) requestAnimationFrame(draw);
  }

  draw();
}

function phoneAction(action) {
  const bridge = window.Android;

  if (bridge && typeof bridge[action] === "function") {
    bridge[action]();
    return;
  }

  const links = {
    wifi: "android.settings.WIFI_SETTINGS",
    bluetooth: "android.settings.BLUETOOTH_SETTINGS",
    settings: "android.settings.SETTINGS",
    camera: "android.media.action.IMAGE_CAPTURE",
    phone: "android.intent.action.DIAL",
    contacts: "android.intent.action.VIEW",
    messages: "android.intent.action.SENDTO"
  };

  if (action === "flashlight") {
    toast("Flashlight needs an Android native connection.");
  } else if (links[action]) {
    toast("This phone shortcut needs the Android native connection.");
  } else {
    toast("This phone action is not connected yet.");
  }
}

function formatTime(seconds) {
  const h = String(Math.floor(seconds / 3600)).padStart(2, "0");
  const m = String(Math.floor((seconds % 3600) / 60)).padStart(2, "0");
  const s = String(seconds % 60).padStart(2, "0");
  return `${h}:${m}:${s}`;
}

function updateUsage() {
  if ($("usageTime")) $("usageTime").textContent = formatTime(usageSeconds);
  if ($("totalUsage")) $("totalUsage").textContent = formatTime(usageTotal);
}

function usageStart() {
  if (usageStarted) return;
  usageStarted = true;
  usageInterval = setInterval(() => {
    usageSeconds++;
    usageTotal++;
    localStorage.setItem("cyberUsageTotal", usageTotal);
    updateUsage();
  }, 1000);
  toast("Started.");
}

function usagePause() {
  usageStarted = false;
  clearInterval(usageInterval);
  toast("Usage timer paused.");
}

function usageStop() {
  usagePause();
  usageSeconds = 0;
  updateUsage();
  toast("Usage timer stopped.");
}

function usageReset() {
  usagePause();
  usageSeconds = 0;
  usageTotal = 0;
  localStorage.setItem("cyberUsageTotal", "0");
  updateUsage();
  toast("Usage timer reset.");
}

function changeTheme(theme) {
  document.documentElement.dataset.theme = theme;
  localStorage.setItem("cyberTheme", theme);
}

function makeQR() {
  const text = $("qrText")?.value.trim();
  if (!text) return toast("Enter text first.");
  const img = document.createElement("img");
  img.alt = "Generated QR code";
  img.style.maxWidth = "220px";
  img.src = "https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=" + encodeURIComponent(text);
  $("qrResult").replaceChildren(img);
}

async function getWeather() {
  const output = $("weatherResult");
  if (!navigator.geolocation) return output.textContent = "Location is not supported.";

  output.textContent = "Getting your location...";
  navigator.geolocation.getCurrentPosition(async position => {
    try {
      const {latitude, longitude} = position.coords;
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&current=temperature_2m,relative_humidity_2m,wind_speed_10m`;
      const data = await (await fetch(url)).json();
      const w = data.current;
      output.textContent = `Temperature: ${w.temperature_2m}°C | Humidity: ${w.relative_humidity_2m}% | Wind: ${w.wind_speed_10m} km/h`;
    } catch {
      output.textContent = "Could not load weather.";
    }
  }, () => output.textContent = "Allow location permission to check local weather.");
}

async function translateText() {
  const text = $("translateText").value.trim();
  const language = $("translateLanguage").value.trim();
  if (!text || !language) return toast("Enter text and a target language.");

  $("translateResult").textContent = "Translating...";
  try {
    $("translateResult").textContent = await askAI(`Translate this into ${language}. Return only the translation:\n${text}`);
  } catch {
    $("translateResult").textContent = "Translation failed. Check your connection.";
  }
}

async function summarizeText() {
  const text = $("summaryText").value.trim();
  if (!text) return toast("Paste text first.");

  $("summaryResult").textContent = "Summarising...";
  try {
    $("summaryResult").textContent = await askAI("Summarise this text clearly:\n" + text);
  } catch {
    $("summaryResult").textContent = "Could not summarise the text.";
  }
}

function saveReminder() {
  const text = $("reminderText").value.trim();
  const time = $("reminderTime").value;
  if (!text || !time) return toast("Enter a reminder and time.");

  const reminders = JSON.parse(localStorage.getItem("cyberReminders") || "[]");
  reminders.push({text, time});
  localStorage.setItem("cyberReminders", JSON.stringify(reminders));
  $("reminderText").value = "";
  showReminders();
  toast("Reminder saved.");
}

function showReminders() {
  const list = $("reminderList");
  if (!list) return;
  const reminders = JSON.parse(localStorage.getItem("cyberReminders") || "[]");
  list.textContent = reminders.map(r => `${r.text} — ${r.time}`).join("\n") || "No reminders saved.";
}

function saveNote() {
  const text = $("noteText").value.trim();
  if (!text) return toast("Write a note first.");

  const notes = JSON.parse(localStorage.getItem("cyberNotes") || "[]");
  notes.unshift(text);
  localStorage.setItem("cyberNotes", JSON.stringify(notes));
  $("noteText").value = "";
  showNotes();
  toast("Note saved.");
}

function showNotes() {
  const list = $("noteList");
  if (!list) return;
  const notes = JSON.parse(localStorage.getItem("cyberNotes") || "[]");
  list.textContent = notes.join("\n\n") || "No notes saved.";
}

function calculate() {
  const expression = $("calcInput").value.trim();
  if (!/^[0-9+\-*/().% ]+$/.test(expression)) {
    $("calcResult").textContent = "Use numbers and calculator operators only.";
    return;
  }

  try {
    const result = Function('"use strict";return (' + expression + ')')();
    $("calcResult").textContent = Number.isFinite(result) ? result : "Invalid calculation.";
  } catch {
    $("calcResult").textContent = "Invalid calculation.";
  }
}

let cameraStream = null;

async function startCamera() {
  try {
    cameraStream = await navigator.mediaDevices.getUserMedia({video: {facingMode: "environment"}});
    $("cameraVideo").srcObject = cameraStream;
  } catch {
    toast("Camera permission was denied or unavailable.");
  }
}

function stopCamera() {
  if (cameraStream) cameraStream.getTracks().forEach(track => track.stop());
  cameraStream = null;
  if ($("cameraVideo")) $("cameraVideo").srcObject = null;
}

function takePhoto() {
  const video = $("cameraVideo");
  const canvas = $("photoCanvas");
  if (!video || !video.videoWidth) return toast("Open the camera first.");

  canvas.width = video.videoWidth;
  canvas.height = video.videoHeight;
  canvas.getContext("2d").drawImage(video, 0, 0);
  const image = document.createElement("img");
  image.src = canvas.toDataURL("image/png");
  image.style.maxWidth = "100%";
  $("photoResult").replaceChildren(image);
}

async function generateImage() {
  const prompt = $("imagePrompt").value.trim();
  if (!prompt) return toast("Describe your image first.");

  $("imageResult").textContent = "Creating your image...";
  try {
    const response = await fetch(IMAGE_URL, {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({prompt})
    });
    if (!response.ok) throw new Error("Image service error.");
    const blob = await response.blob();
    const image = document.createElement("img");
    image.src = URL.createObjectURL(blob);
    image.alt = prompt;
    image.style.width = "100%";
    $("imageResult").replaceChildren(image);
  } catch (error) {
    $("imageResult").textContent = "Image generation failed. Check your connection.";
  }
}

function saveHistory(question, answer) {
  const history = JSON.parse(localStorage.getItem("cyberHistory") || "[]");
  history.unshift({question, answer, date: new Date().toLocaleString()});
  localStorage.setItem("cyberHistory", JSON.stringify(history.slice(0, 30)));
  showHistory();
}

function showHistory() {
  const list = $("historyList");
  if (!list) return;
  const history = JSON.parse(localStorage.getItem("cyberHistory") || "[]");
  list.innerHTML = "";

  if (!history.length) {
    list.textContent = "No saved conversations yet.";
    return;
  }

  history.forEach(item => {
    const entry = document.createElement("div");
    entry.className = "history-entry";
    const title = document.createElement("strong");
    title.textContent = item.question;
    const date = document.createElement("small");
    date.textContent = item.date;
    entry.append(title, date);
    list.appendChild(entry);
  });
}

document.addEventListener("DOMContentLoaded", () => {
  const savedTheme = localStorage.getItem("cyberTheme") || "dark";
  changeTheme(savedTheme);
  if ($("themeSelect")) $("themeSelect").value = savedTheme;

  updateUsage();
  showHistory();
  animateAvatar();

  document.querySelectorAll("[data-page]").forEach(button => {
    button.addEventListener("click", () => goToPage(button.dataset.page));
  });

  if ($("sendButton")) $("sendButton").addEventListener("click", sendMessage);
  if ($("micButton")) $("micButton").addEventListener("click", toggleMic);

  const input = $("chatInput") || $("messageInput");
  if (input) {
    input.addEventListener("keydown", event => {
      if (event.key === "Enter" && !event.shiftKey) {
        event.preventDefault();
        sendMessage();
      }
    });
  }
});
</script>
