<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
<meta name="theme-color" content="#080d1c">
<title>Cyber AI — Personal Assistant</title>
<style>
:root{--bg:#080d1c;--panel:#111a2d;--panel2:#17233a;--line:#263650;--text:#edf4ff;--muted:#91a2bd;--blue:#6ea8ff;--cyan:#55e2dc;--purple:#a88bff;--danger:#ff7185;--good:#65d6a4;--shadow:0 18px 55px #0006}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;background:radial-gradient(ellipse at 50% -20%,#1b3155 0,#080d1c 55%);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif}
button,input,textarea,select{font:inherit}
button{cursor:pointer;color:inherit}
button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:2px solid var(--cyan);outline-offset:2px}
.app{max-width:1500px;margin:auto;min-height:100vh;display:grid;grid-template-columns:250px minmax(0,1fr);gap:18px;padding:18px}
.sidebar,.card{background:linear-gradient(160deg,#121d32ed,#0e1729f2);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}
.sidebar{padding:20px 14px;display:flex;flex-direction:column;gap:16px;height:calc(100vh - 36px);position:sticky;top:18px}
.brand{display:flex;align-items:center;gap:12px;padding:4px 8px 16px;border-bottom:1px solid var(--line)}
.brand-mark{width:42px;height:42px;border-radius:14px;background:linear-gradient(135deg,var(--blue),var(--cyan));display:grid;place-items:center;color:#071321;font-weight:900;font-size:20px}
.brand h1{font-size:17px;margin:0}
.brand small{color:var(--muted)}
.nav{display:grid;gap:7px}
.nav button,.side-action{background:transparent;border:1px solid transparent;border-radius:12px;padding:12px;text-align:left;color:#b9c8df;display:flex;gap:12px;align-items:center}
.nav button.active,.nav button:hover,.side-action:hover{background:#20314e;border-color:#31496b;color:white}
.nav .ico{width:22px;text-align:center;color:var(--cyan)}
.sidebar-bottom{margin-top:auto;display:grid;gap:9px}
.status{font-size:12px;color:var(--muted);padding:12px;background:#0b1425;border:1px solid var(--line);border-radius:12px;line-height:1.6}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--danger);margin-right:6px}
.dot.on{background:var(--good)}
main{min-width:0;display:flex;flex-direction:column;gap:16px}
.topbar{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:4px 2px}
.topbar h2{margin:0;font-size:clamp(20px,3vw,28px)}
.topbar p{margin:4px 0 0;color:var(--muted);font-size:13px}
.top-actions{display:flex;gap:8px;flex-wrap:wrap}
.btn{border:1px solid var(--line);background:#1a2942;padding:10px 14px;border-radius:12px;font-weight:650}
.btn:hover{filter:brightness(1.15)}
.btn.primary{background:linear-gradient(135deg,#367ee8,#2dbcb8);border:0;color:#061323}
.btn.danger{background:#482234;border-color:#733347}
.btn.small{padding:7px 10px;font-size:12px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.page{display:none}
.page.active{display:block}
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:15px}
.span-12{grid-column:span 12}
.span-8{grid-column:span 8}
.span-7{grid-column:span 7}
.span-6{grid-column:span 6}
.span-5{grid-column:span 5}
.span-4{grid-column:span 4}
.card{padding:18px;min-width:0}
.card h3{margin:0 0 12px;font-size:16px}
.muted{color:var(--muted)}
.tiny{font-size:12px;color:var(--muted)}
.hero{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(260px,.9fr);gap:16px;align-items:center;min-height:330px}
.hero-copy h3{font-size:clamp(26px,4vw,40px);line-height:1.1;margin:0 0 12px}
.hero-copy p{color:#aebed6;line-height:1.65}
.hero-actions{display:flex;gap:9px;flex-wrap:wrap;margin-top:18px}
.avatar-wrap{height:300px;min-width:0;position:relative;border-radius:18px;background:radial-gradient(ellipse at 50% 45%,#26456b 0,#14233b 48%,#0a1324 78%);overflow:hidden;border:1px solid #304765}
.avatar-wrap canvas{width:100%;height:100%;display:block}
.avatar-label{position:absolute;left:12px;bottom:12px;background:#071321b8;border:1px solid #ffffff20;border-radius:10px;padding:7px 10px;font-size:11px;color:#c5d7ef;backdrop-filter:blur(8px)}
.avatar-words{position:absolute;left:12px;right:12px;top:12px;max-height:92px;overflow:auto;padding:10px 12px;border:1px solid #8abaff55;border-radius:13px;background:#071321d9;color:#f1f7ff;font-size:13px;line-height:1.45;white-space:pre-wrap;overflow-wrap:anywhere;backdrop-filter:blur(10px);box-shadow:0 8px 24px #0005}
.avatar-words:empty{display:none}
.stat{display:flex;justify-content:space-between;align-items:center}
.stat strong{font-size:25px}
.stat .symbol{font-size:22px;color:var(--cyan)}
.chat-layout{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:15px}
.chat-card{height:min(72vh,760px);display:flex;flex-direction:column}
.chat-head{display:flex;justify-content:space-between;align-items:center;padding-bottom:12px;border-bottom:1px solid var(--line)}
.chat-head h3{margin:0}
.messages{flex:1;overflow:auto;padding:15px 2px;display:flex;flex-direction:column;gap:12px;scroll-behavior:smooth}
.msg{max-width:88%;padding:12px 14px;border-radius:16px;line-height:1.5;white-space:pre-wrap;overflow-wrap:anywhere}
.msg.user{align-self:flex-end;background:linear-gradient(135deg,#286bc7,#267e9c);color:white;border-bottom-right-radius:5px}
.msg.assistant{align-self:flex-start;background:#1a2942;border:1px solid #30435f;border-bottom-left-radius:5px}
.msg.system{align-self:center;background:#192337;color:#aebed6;font-size:12px;text-align:center;max-width:100%}
.msg a{color:#82c5ff}
.composer{border-top:1px solid var(--line);padding-top:12px}
.compose-row{display:flex;gap:8px;align-items:flex-end}
.compose-row textarea{flex:1;resize:vertical;min-height:46px;max-height:130px;background:#091426;border:1px solid #31435f;color:white;border-radius:13px;padding:12px}
.compose-tools{display:flex;gap:7px;margin-top:8px;flex-wrap:wrap}
.icon-btn{width:44px;height:44px;border:1px solid var(--line);border-radius:12px;background:#1b2a43;font-size:17px}
.icon-btn.listening{background:#51283b;border-color:#a44a66;box-shadow:0 0 0 4px #e34d7222}
.quick-list{display:grid;gap:8px}
.quick-list button{padding:11px;border-radius:12px;border:1px solid var(--line);background:#101c30;text-align:left;color:#dce8fa}
.quick-list button:hover{border-color:var(--cyan)}
.field{display:grid;gap:6px;margin:11px 0}
.field label{font-size:12px;color:#aebed6}
.field input,.field textarea,.field select{width:100%;background:#091426;border:1px solid #30435f;border-radius:11px;color:white;padding:11px}
.field textarea{min-height:90px;resize:vertical}
.help{font-size:11px;color:var(--muted);line-height:1.5}
.list{display:grid;gap:8px}
.item{display:flex;align-items:center;gap:10px;padding:11px;background:#101c30;border:1px solid var(--line);border-radius:12px}
.item .grow{flex:1;min-width:0;overflow-wrap:anywhere}
.item.done .grow{text-decoration:line-through;color:#7788a3}
.item button{border:0;background:transparent;color:#9eb1cc}
.empty{color:var(--muted);text-align:center;padding:25px 10px;font-size:13px}
.tool-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:12px}
.tool-tile{padding:16px;border:1px solid var(--line);background:#101c30;border-radius:15px;text-align:left}
.tool-tile b{display:block;margin:0 0 6px}
.tool-tile span{color:var(--muted);font-size:12px}
#cameraVideo{width:100%;max-height:360px;background:#050a13;border-radius:14px}
#cameraCanvas{display:none;max-width:100%;border-radius:14px}
.qr-output{background:white;min-height:130px;border-radius:12px;padding:12px;display:grid;place-items:center;color:#111}
.footer-note{font-size:11px;color:var(--muted);line-height:1.5;margin-top:12px}
.toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#20314b;border:1px solid #49617f;padding:11px 16px;border-radius:12px;z-index:20;box-shadow:var(--shadow);display:none;max-width:90vw}
@media(max-width:900px){.app{grid-template-columns:1fr;padding:10px;gap:10px}.sidebar{height:auto;position:relative;top:auto;padding:12px}.brand{padding-bottom:10px}.nav{grid-template-columns:repeat(4,minmax(0,1fr))}.nav button{justify-content:center;padding:10px 5px;font-size:11px;flex-direction:column;gap:4px}.sidebar-bottom{display:none}.hero{grid-template-columns:1fr}.avatar-wrap{height:280px}.chat-layout{grid-template-columns:1fr}.chat-side{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}.span-8,.span-7,.span-6,.span-5,.span-4{grid-column:span 12}}
@media(max-width:520px){.topbar{align-items:flex-start}.top-actions .btn{padding:8px 10px;font-size:12px}.card{padding:14px}.chat-card{height:66vh}.chat-side{grid-template-columns:1fr 1fr}.hero-copy h3{font-size:29px}.avatar-wrap{height:245px}}
</style>
